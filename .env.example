# NNIT Studio V39 environment template
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Public API URL used by clients
VITE_API_URL=http://localhost:4000

# Production values: set these in Railway/GitHub secrets, never commit real secrets
NNIT_APP_ENV=development
NNIT_PUBLIC_APP_URL=http://localhost:5173
NNIT_API_BASE_URL=http://localhost:4000

# Replace with production-grade secret values before deployment
NNIT_AUTH_SECRET=change-me
NNIT_ENCRYPTION_KEY=change-me

# Optional external services
DATABASE_URL=
REDIS_URL=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
