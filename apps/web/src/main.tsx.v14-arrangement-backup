  {page==='Desktop'&&<section className="page"><h2>V8 Native Desktop Engine</h2><div className="notice">Desktop bridge: <b>{(window as any).nnitDesktop?.isDesktop?'Electron connected':'Browser mode'}</b> · Native host: <b>{nativeStatus?.nativeHostLoaded?'loaded':'bridge ready; compiled ASIO/VST3 host not loaded'}</b> · Local AI: <b>{localAi?.reachable?'online':'offline/not configured'}</b></div>{nativeSettings&&<div className="productionGrid"><div className="productionPanel"><h3>Audio Driver</h3><label>Mode<select value={nativeSettings.driverMode} onChange={e=>void saveNativeSettings({driverMode:e.target.value})}><option>WASAPI Shared</option><option>WASAPI Exclusive</option><option>ASIO</option></select></label><label>Sample Rate<select value={nativeSettings.sampleRate} onChange={e=>void saveNativeSettings({sampleRate:Number(e.target.value)})}>{[44100,48000,88200,96000].map(x=><option key={x}>{x}</option>)}</select></label><label>Buffer<select value={nativeSettings.bufferSize} onChange={e=>void saveNativeSettings({bufferSize:Number(e.target.value)})}>{[64,128,256,512,1024].map(x=><option key={x}>{x}</option>)}</select></label><label><input type="checkbox" checked={nativeSettings.exclusiveMode} onChange={e=>void saveNativeSettings({exclusiveMode:e.target.checked})}/> Exclusive mode</label></div><div className="productionPanel"><h3>MIDI / System</h3><p>Platform: <b>{nativeStatus?.platform||'checking'}</b></p><p>Architecture: <b>{nativeStatus?.arch||'checking'}</b></p><p>CPU threads: <b>{nativeStatus?.cpus||'checking'}</b></p><p>MIDI: <b>{nativeStatus?.midi||'Web MIDI + bridge'}</b></p><button onClick={()=>navigator.requestMIDIAccess?.().then(()=>setStatus('MIDI access granted')).catch(()=>setStatus('MIDI permission unavailable'))}>Request MIDI Access</button></div><div className="productionPanel"><h3>Local AI Bridge</h3><label>Service URL<input value={nativeSettings.localAiUrl} onChange={e=>setNativeSettings({...nativeSettings,localAiUrl:e.target.value})}/></label><button onClick={()=>void saveNativeSettings({localAiUrl:nativeSettings.localAiUrl})}>Save AI URL</button><button onClick={async()=>setLocalAi(await request('/api/ai/local/status'))}>Test Local AI</button><p>{localAi?.reachable?'Service reachable':'Waiting for local model service'}</p></div></div>}</section>}
  {page==='Plugins'&&<section className="page"><h2>V9 Plugin Racks</h2><div className="notice">Scanned VST3 plugins can now be assigned persistently to track racks. The V9 native host validates/isolate paths; actual VST3 DSP loading still requires the compiled Steinberg-SDK host.</div><div className="buttonRow"><button onClick={()=>void pickPluginFolder()}>Add Folder</button><button onClick={()=>void scanPlugins()}><Activity/> Scan VST3</button></div><div className="pluginWorkbench"><div><h3>Registry</h3><div className="pluginList">{plugins.length===0?<p>No plugins scanned.</p>:plugins.map(p=><div className="pluginCard" key={p.id}><div><b>{p.name}</b><small>{p.path}</small></div><span>{p.format}</span><span className={p.status==='available'?'ok':'bad'}>{p.status}</span><button disabled={!selected} onClick={()=>void addPluginToTrack(p.id)}>Add to Track</button></div>)}</div></div><div><h3>Selected Track Rack</h3>{tr?<><p><b>{tr.name}</b></p><div className="rack">{tr.pluginRack.length===0?<p>Rack empty</p>:tr.pluginRack.map((slot:PluginSlot)=><div className="rackSlot" key={slot.id}><span>{slot.order+1}</span><b>{slot.name}</b><button onClick={()=>void toggleTrackPlugin(tr.id,slot)}>{slot.enabled?'On':'Bypass'}</button><button onClick={()=>void removeTrackPlugin(tr.id,slot.id)}>Remove</button></div>)}</div></>:<p>Select a track in Studio first.</p>}</div></div></section>}


  {page==='Engine'&&<section className="page"><h2>V14 Editing + Arrangement Engine Bridge</h2><div className="productionGrid"><div className="productionPanel"><h3>Native Host</h3><p>Status: <b>{nativeHost?.reachable?'ONLINE':'OFFLINE'}</b></p><p>URL: {nativeHost?.url||nativeSettings?.nativeHostUrl||'http://127.0.0.1:8766'}</p><p>VST3 native loader: <b>{nativeHost?.vst3HostLoaded?'loaded':'SDK host required'}</b></p><p>ASIO adapter: <b>{nativeHost?.asioAdapterLoaded?'loaded':'adapter required'}</b></p><button onClick={async()=>setNativeHost(await request('/api/native/host/status'))}>Refresh Host</button></div><div className="productionPanel"><h3>Windows Devices</h3><p>Audio devices: <b>{nativeDevices?.audio?.length||0}</b></p><p>Endpoints: <b>{nativeDevices?.endpoints?.length||0}</b></p><div className="deviceMiniList">{(nativeDevices?.endpoints||[]).slice(0,8).map((d:any,i:number)=><small key={i}>{d.FriendlyName||d.Name||'Audio endpoint'} · {d.Status||''}</small>)}</div><button onClick={async()=>setNativeDevices(await request('/api/native/devices'))}>Refresh Devices</button></div><div className="productionPanel"><h3>Local AI Worker</h3><p>Status: <b>{localAi?.reachable?'ONLINE':'OFFLINE'}</b></p><p>URL: {localAi?.url||nativeSettings?.localAiUrl||'http://127.0.0.1:8765'}</p><div className="deviceMiniList">{(localCaps?.capabilities||[]).map((c:any,i:number)=><small key={i}>{c.type} · {c.mode}</small>)}</div><button onClick={async()=>{setLocalAi(await request('/api/ai/local/status'));setLocalCaps(await request('/api/ai/local/capabilities'))}}>Refresh AI</button></div></div><div className="notice">Use the V10 desktop launcher to start the API/Web studio, Native Host service, Local AI worker and Electron desktop together.</div></section>}

  {page==='Cloud'&&<section className="page"><h2>NNIT Cloud</h2><Cloud size={48}/><p>Local project persistence: <b>{cloud?.localPersistence?'Active':'Checking'}</b></p><p>Persistent media: <b>{cloud?.persistentMedia?'Active':'Checking'}</b></p><p>Version history: <b>{cloud?.versionHistory?'Active':'Checking'}</b></p><p>Global provider: <b>{cloud?.connected?'Connected':'Adapter ready — credentials required'}</b></p></section>}
  {page==='Marketplace'&&<section className="page"><h2>NNIT Marketplace</h2><div className="cards">{market.map(m=><div className="card" key={m.id}><Store/><b>{m.name}</b><span>{m.category}</span><strong>{m.price} {m.currency}</strong><button disabled>NNIT Pay adapter</button></div>)}</div></section>}
  {page==='History'&&<section className="page"><h2>Project Version History</h2><button onClick={()=>void saveProject()}><Save/> Save New Version</button><div className="versions">{versions.length===0?<p>No saved versions yet.</p>:versions.map(v=><div key={v.id}><div><b>{v.label}</b><small>{new Date(v.createdAt).toLocaleString()}</small></div><button onClick={()=>void restoreVersion(v.id)}>Restore</button></div>)}</div></section>}
  </main></div>
}

createRoot(document.getElementById('root')!).render(<App/>);
