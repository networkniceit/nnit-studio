import React,{useEffect,useRef,useState} from 'react';
import {createRoot} from 'react-dom/client';
import {Mic2,SlidersHorizontal,Wand2,Music2,Cloud,Store,Play,Square,Circle,Plus,Upload,Save,Trash2,Activity,Download} from 'lucide-react';
import './styles.css';
const API='http://localhost:4000';
type Clip={id:string;name:string;start:number;duration:number;kind:string};
type Track={id:string;name:string;kind:string;gainDb:number;pan:number;mute:boolean;solo:boolean;armed:boolean;effects:{reverb:number;delay:number;eq:boolean;compressor:boolean;gate:boolean};clips:Clip[]};
type Project={id:string;name:string;bpm:number;key:string;sampleRate:number;bitDepth:number;tracks:Track[]};
type Page='Studio'|'Recording'|'Mixer'|'AI Studio'|'Cloud'|'Marketplace';
async function request(path:string,init?:RequestInit){const r=await fetch(API+path,{...init,headers:{'content-type':'application/json',...(init?.headers||{})}});if(!r.ok)throw new Error(`${r.status} ${r.statusText}`);if(r.status===204)return null;return r.json();}
function App(){const [projects,setProjects]=useState<Project[]>([]);const [active,setActive]=useState<Project|null>(null);const [selected,setSelected]=useState<string>('');const [page,setPage]=useState<Page>('Studio');const [status,setStatus]=useState('Connecting...');const [recording,setRecording]=useState(false);const [playing,setPlaying]=useState(false);const [analysis,setAnalysis]=useState<any>(null);const [aiJobs,setAiJobs]=useState<any[]>([]);const [market,setMarket]=useState<any[]>([]);const [cloud,setCloud]=useState<any>(null);const media=useRef<MediaRecorder|null>(null);const chunks=useRef<Blob[]>([]);const audioUrls=useRef<Record<string,string>>({});
 const load=async(prefer?:string)=>{try{const d=await request('/api/projects');const items=Array.isArray(d.items)?d.items:[];setProjects(items);const id=prefer||active?.id;const p=items.find((x:Project)=>x.id===id)||items[0]||null;setActive(p);if(p&&!p.tracks.some((t:Track)=>t.id===selected))setSelected(p.tracks[0]?.id||'');setStatus(`API connected · ${items.length} project${items.length===1?'':'s'}`);}catch(e:any){setStatus('API error · '+e.message)}};
 useEffect(()=>{void load();},[]);
 const createProject=async()=>{const p=await request('/api/projects',{method:'POST',body:JSON.stringify({name:`New Studio Project ${projects.length+1}`})});await load(p.id)};
 const saveProject=async()=>{if(!active)return;const p=await request(`/api/projects/${active.id}`,{method:'PATCH',body:JSON.stringify({name:active.name,bpm:active.bpm,key:active.key})});setActive(p);await load(p.id)};
 const deleteProject=async()=>{if(!active||!confirm(`Delete ${active.name}?`))return;await request(`/api/projects/${active.id}`,{method:'DELETE'});setActive(null);await load()};
 const addTrack=async()=>{if(!active)return;const name=prompt('Track name','Audio Track');if(!name)return;await request(`/api/projects/${active.id}/tracks`,{method:'POST',body:JSON.stringify({name,kind:'audio'})});await load(active.id)};
 const patchTrack=async(id:string,patch:any)=>{if(!active)return;await request(`/api/projects/${active.id}/tracks/${id}`,{method:'PATCH',body:JSON.stringify(patch)});await load(active.id)};
 const deleteTrack=async(id:string)=>{if(!active)return;await request(`/api/projects/${active.id}/tracks/${id}`,{method:'DELETE'});await load(active.id)};
 const startRecording=async()=>{if(!active||!selected)return alert('Select an audio track first.');const track=active.tracks.find(t=>t.id===selected);if(!track||track.kind!=='audio')return alert('Recording requires an audio track.');try{const stream=await navigator.mediaDevices.getUserMedia({audio:true});chunks.current=[];const rec=new MediaRecorder(stream);media.current=rec;rec.ondataavailable=e=>{if(e.data.size)chunks.current.push(e.data)};rec.onstop=async()=>{const blob=new Blob(chunks.current,{type:rec.mimeType||'audio/webm'});const url=URL.createObjectURL(blob);const name=`${track.name} take ${new Date().toLocaleTimeString()}`;const clip=await request(`/api/projects/${active.id}/tracks/${track.id}/clips`,{method:'POST',body:JSON.stringify({name,duration:0,kind:'recording'})});audioUrls.current[clip.id]=url;stream.getTracks().forEach(t=>t.stop());await load(active.id)};rec.start();setRecording(true)}catch(e:any){alert('Microphone error: '+e.message)}};
 const stopRecording=()=>{media.current?.stop();setRecording(false)};
 const importAudio=(file:File|null)=>{if(!file||!active||!selected)return;const track=active.tracks.find(t=>t.id===selected);if(!track)return;const url=URL.createObjectURL(file);void request(`/api/projects/${active.id}/tracks/${track.id}/clips`,{method:'POST',body:JSON.stringify({name:file.name,duration:0,kind:'import'})}).then(async c=>{audioUrls.current[c.id]=url;await load(active.id)})};
 const analyze=async()=>{if(active)setAnalysis(await request(`/api/projects/${active.id}/master/analyze`,{method:'POST'}))};
 const aiJob=async(type:string)=>{if(!active)return;await request(`/api/projects/${active.id}/ai/jobs`,{method:'POST',body:JSON.stringify({type})});const d=await request('/api/ai/jobs');setAiJobs(d.items||[])};
 const openPage=async(p:Page)=>{setPage(p);if(p==='Cloud')setCloud(await request('/api/cloud/status'));if(p==='Marketplace'){const d=await request('/api/marketplace');setMarket(d.items||[])}if(p==='AI Studio'){const d=await request('/api/ai/jobs');setAiJobs(d.items||[])}};
 const tr=active?.tracks.find(t=>t.id===selected)||null;
 return <div className="app"><aside><div className="brand">NNIT <b>STUDIO V3</b></div><button className="primary" onClick={createProject}><Plus size={16}/> New Project</button><nav>{([{n:'Studio',i:<Music2/>},{n:'Recording',i:<Mic2/>},{n:'Mixer',i:<SlidersHorizontal/>},{n:'AI Studio',i:<Wand2/>},{n:'Cloud',i:<Cloud/>},{n:'Marketplace',i:<Store/>}] as any[]).map(x=><button key={x.n} className={page===x.n?'navon':''} onClick={()=>void openPage(x.n)}>{x.i}{x.n}</button>)}</nav><div className="projects"><label>PROJECTS</label>{projects.map(p=><div className={active?.id===p.id?'sel':''} onClick={()=>{setActive(p);setSelected(p.tracks[0]?.id||'')}} key={p.id}>{p.name}</div>)}</div></aside><main><header><div className="title"><input value={active?.name||''} onChange={e=>active&&setActive({...active,name:e.target.value})}/><div className="meta"><input type="number" value={active?.bpm||120} onChange={e=>active&&setActive({...active,bpm:Number(e.target.value)})}/> BPM · {active?.sampleRate||48000} Hz · {active?.bitDepth||24}-bit · {active?.key||'C Major'}</div></div><div className="transport"><button onClick={()=>setPlaying(!playing)} className={playing?'active':''}><Play/></button><button onClick={()=>setPlaying(false)}><Square/></button>{recording?<button className="rec on" onClick={stopRecording}><Square/></button>:<button className="rec" onClick={()=>void startRecording()}><Circle/></button>}<button title="Save" onClick={()=>void saveProject()}><Save/></button><button title="Delete project" onClick={()=>void deleteProject()}><Trash2/></button></div></header><div className="status">{status}</div>
 {page==='Studio'&&<><div className="toolbar"><button onClick={()=>void addTrack()}><Plus/> Add Track</button><label className="file"><Upload/> Import Audio<input type="file" accept="audio/*" onChange={e=>importAudio(e.target.files?.[0]||null)}/></label><span>Workspace: local persistent API</span></div><section className="timeline"><div className="ruler">1　　2　　3　　4　　5　　6　　7　　8</div>{active?.tracks.map(t=><div className={'track '+(selected===t.id?'selected':'')} key={t.id} onClick={()=>setSelected(t.id)}><div className="trackname"><b>{t.name}</b><small>{t.kind}</small><div><button className={t.mute?'tiny on':''} onClick={e=>{e.stopPropagation();void patchTrack(t.id,{mute:!t.mute})}}>M</button><button className={t.solo?'tiny on':''} onClick={e=>{e.stopPropagation();void patchTrack(t.id,{solo:!t.solo})}}>S</button><button className={t.armed?'tiny arm':''} onClick={e=>{e.stopPropagation();void patchTrack(t.id,{armed:!t.armed})}}>R</button></div></div><div className="lane">{t.clips.map((c,i)=><div className="clip" key={c.id} style={{left:`${2+i*18}%`,width:'16%'}}><span>{c.name}</span>{audioUrls.current[c.id]&&<audio controls src={audioUrls.current[c.id]}/>}</div>)}</div></div>)}</section><section className="bottom"><div className="panel"><h3>Channel Strip — {tr?.name||'Select track'}</h3>{tr&&<div className="controls"><label>Gain <b>{tr.gainDb} dB</b><input type="range" min="-24" max="12" step="1" value={tr.gainDb} onChange={e=>void patchTrack(tr.id,{gainDb:Number(e.target.value)})}/></label><label>Pan <b>{tr.pan}</b><input type="range" min="-1" max="1" step="0.1" value={tr.pan} onChange={e=>void patchTrack(tr.id,{pan:Number(e.target.value)})}/></label><label>Reverb <b>{tr.effects.reverb}%</b><input type="range" min="0" max="100" value={tr.effects.reverb} onChange={e=>void patchTrack(tr.id,{effects:{reverb:Number(e.target.value)}})}/></label><button onClick={()=>void deleteTrack(tr.id)}><Trash2/> Track</button></div>}</div><div className="panel"><h3>Mastering</h3><p>-14 LUFS target · -1.0 dBTP ceiling</p><button onClick={()=>void analyze()}><Activity/> Analyze Mix</button>{analysis&&<p>LUFS {analysis.integratedLufs} · Peak {analysis.truePeak} dBTP · DR {analysis.dynamicRange}</p>}</div><div className="panel"><h3>NNIT AI</h3><p>Provider-ready jobs: stems · denoise · key/BPM · mix assistant</p><button onClick={()=>void aiJob('mix-assistant')}><Wand2/> Queue Mix Assistant</button></div></section></>}
 {page==='Recording'&&<section className="page"><h2>Recording Studio</h2><p>Select an audio track, then use the transport record button. Browser microphone capture is active in V3.</p><div className="cards">{active?.tracks.filter(t=>t.kind==='audio').map(t=><button key={t.id} className={selected===t.id?'card chosen':'card'} onClick={()=>setSelected(t.id)}><Mic2/><b>{t.name}</b><span>{t.clips.length} clips</span></button>)}</div></section>}
 {page==='Mixer'&&<section className="page"><h2>Professional Mixer</h2><div className="mixer">{active?.tracks.map(t=><div className="channel" key={t.id}><b>{t.name}</b><span>{t.kind}</span><input className="fader" type="range" min="-24" max="12" value={t.gainDb} onChange={e=>void patchTrack(t.id,{gainDb:Number(e.target.value)})}/><strong>{t.gainDb} dB</strong><div><button onClick={()=>void patchTrack(t.id,{mute:!t.mute})} className={t.mute?'on':''}>M</button><button onClick={()=>void patchTrack(t.id,{solo:!t.solo})} className={t.solo?'on':''}>S</button></div></div>)}</div></section>}
 {page==='AI Studio'&&<section className="page"><h2>NNIT AI Studio</h2><div className="cards">{['stem-separation','denoise','key-bpm','mix-assistant','mastering-assistant'].map(x=><button className="card" key={x} onClick={()=>void aiJob(x)}><Wand2/><b>{x}</b><span>Queue provider job</span></button>)}</div><h3>Jobs</h3>{aiJobs.map(j=><p key={j.id}>{j.type} — {j.status} — {j.provider}</p>)}</section>}
 {page==='Cloud'&&<section className="page"><h2>NNIT Cloud</h2><Cloud size={48}/><p>Local persistence: <b>{cloud?.localPersistence?'Active':'Checking'}</b></p><p>Global cloud provider: <b>{cloud?.connected?'Connected':'Adapter ready — credentials required'}</b></p><p>Projects are currently persisted by the NNIT Studio backend in database/studio-data.json.</p></section>}
 {page==='Marketplace'&&<section className="page"><h2>NNIT Marketplace</h2><div className="cards">{market.map(m=><div className="card" key={m.id}><Store/><b>{m.name}</b><span>{m.category}</span><strong>{m.price} {m.currency}</strong><button disabled>NNIT Pay adapter</button></div>)}</div></section>}
 </main></div>}
createRoot(document.getElementById('root')!).render(<App/>);
