{
  "name": "@nnit-studio/desktop",
  "version": "0.39.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --config vite.config.mjs\" \"wait-on http://localhost:5174 && electron .\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "electron": "^37.3.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "vite": "^7.1.3",
    "wait-on": "^8.0.4",
    "typescript": "^5.9.2",
    "@types/node": "^22.17.2"
  }
}
