{
    "name":  "@nnit-studio/desktop",
    "version":  "0.39.0",
    "private":  true,
    "type":  "module",
    "main":  "dist/main.js",
    "scripts":  {
                    "dev":  "concurrently -k \"vite --config vite.config.mjs\" \"wait-on http://localhost:5174 \u0026\u0026 electron .\"",
                    "build":  "tsc -p tsconfig.json",
                    "typecheck":  "tsc -p tsconfig.json --noEmit",
                    "package":  "electron-builder --win"
                },
    "dependencies":  {

                     },
    "devDependencies":  {
                            "@types/node":  "^22.17.2",
                            "concurrently":  "^9.2.0",
                            "electron-builder":  "^26.15.3",
                            "typescript":  "^5.9.2",
                            "vite":  "^7.1.3",
                            "wait-on":  "^8.0.4",
                            "electron":  "^43.4.0"
                        },
    "buildConfig":  {
                        "appId":  "com.networkniceit.nnitstudio",
                        "productName":  "NNIT Studio",
                        "directories":  {
                                            "output":  "release"
                                        },
                        "files":  [
                                      "dist/**/*",
                                      "package.json"
                                  ],
                        "win":  {
                                    "target":  [
                                                   "nsis"
                                               ]
                                }
                    },
    "description":  "NNIT Studio desktop application",
    "author":  "Network Nice IT"
}